    },
    {
      "parameters": {
        "jsCode": "const approval = $('Prepare Approval Decision').first().json;\nconst rows = $input.all().map(item => item.json);\n\nconst invoice = rows.find(row =>\n  String(row['Invoice ID'] ?? '').trim() ===\n  String(approval.invoiceId ?? '').trim()\n);\n\nreturn [\n  {\n    json: {\n      ...approval,\n      invoiceFound: !!invoice,\n      currentStatus: invoice ? invoice['Status'] : null,\n      rowNumber: invoice ? invoice.row_number : null,\n      invoiceNumber: invoice ? invoice['Invoice Number'] : null,\n      supplier: invoice ? invoice['Supplier'] : null,\n      amount: invoice ? invoice['Amount'] : null\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        -32
      ],
