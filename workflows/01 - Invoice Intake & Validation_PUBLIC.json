    {
      "parameters": {
        "jsCode": "const submitted = $('Prepare Invoice Data').first().json;\nconst existingInvoices = $input.all().map(item => item.json);\n\nconst duplicateFound = existingInvoices.some(row =>\n  String(row['Invoice Number'] ?? '').trim() ===\n    String(submitted.invoiceNumber ?? '').trim()\n  &&\n  String(row['Supplier'] ?? '').trim().toLowerCase() ===\n    String(submitted.supplier ?? '').trim().toLowerCase()\n);\n\nreturn [\n  {\n    json: {\n      ...submitted,\n      duplicateFound\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
