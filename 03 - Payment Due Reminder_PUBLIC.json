      "id": "bd406495-9741-4abc-a0ae-186a8df3ac40",
      "name": "Read Invoice Register"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst todayString = $('Set Current Date').first().json.today;\n\nconst today = new Date(todayString + 'T00:00:00');\n\nconst results = [];\n\nfor (const item of rows) {\n  const row = item.json;\n\n  // Only approved invoices should be considered\n  if (String(row['Status'] ?? '').trim() !== 'Approved') {\n    continue;\n  }\n\n  // Ignore invoices already marked as paid\n  const paidAt = String(row['Paid At'] ?? '').trim();\n\n  if (paidAt && paidAt !== '-') {\n    continue;\n  }\n\n  const dueDateString = String(row['Due Date'] ?? '').trim();\n\n  if (!dueDateString) {\n    continue;\n  }\n\n  const dueDate = new Date(dueDateString + 'T00:00:00');\n\n  const diffMs = dueDate.getTime() - today.getTime();\n  const daysUntilDue = Math.round(diffMs / (1000 * 60 * 60 * 24));\n\n  let paymentStatus = null;\n\n  if (daysUntilDue < 0) {\n    paymentStatus = 'Overdue';\n  } else if (daysUntilDue === 0) {\n    paymentStatus = 'Due Today';\n  } else if (daysUntilDue <= 7) {\n    paymentStatus = 'Due Soon';\n  }\n\n  // No reminder needed yet\n  if (!paymentStatus) {\n    continue;\n  }\n\n  // Prevent repeated reminders on the same day\n  const lastReminderDate = String(row['Last Reminder Date'] ?? '').trim();\n\n  if (lastReminderDate === todayString) {\n    continue;\n  }\n\n  results.push({\n    json: {\n      rowNumber: row.row_number,\n      invoiceId: row['Invoice ID'],\n      invoiceNumber: row['Invoice Number'],\n      supplier: row['Supplier'],\n      project: row['Project'],\n      amount: row['Amount'],\n      currency: row['Currency'],\n      dueDate: row['Due Date'],\n      paymentStatus,\n      daysUntilDue,\n      reminderSent: row['Reminder Sent'],\n      lastReminderDate: row['Last Reminder Date'],\n      today: todayString\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
